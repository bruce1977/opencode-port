{
  "name": "opencode-port",
  "version": "0.1.0",
  "private": true,
  "description": "把 opencode serve 的内置免费模型与能力封装为 OpenAI / Anthropic 兼容 API 的网关",
  "license": "MIT",
  "type": "module",
  "main": "src/index.mjs",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "start": "node src/index.mjs",
    "dev": "node --watch src/index.mjs",
    "lint": "eslint --config config/eslint.config.mjs .",
    "lint:fix": "eslint --config config/eslint.config.mjs . --fix",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "check": "npm run lint && npm test"
  },
  "dependencies": {
    "@opencode/client": "2.1.4",
    "fastify": "^5.12.7",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0"
  }
}
