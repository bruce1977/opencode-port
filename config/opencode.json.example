{
  "$schema": "https://opencode.ai/config.json",
  "plugins": ["-opencode.provider.ollama"],
  "providers": {
    "ollama-local": {
      "name": "ollama-local",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://host.docker.internal:11434/v1",
        "apiKey": "{env:OLLAMA_API_KEY}"
      },
      "models": {}
    }
  },
  "websearch": {
    "provider": "random"
  }
}
