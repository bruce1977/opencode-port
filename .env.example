# `npm start` / `npm run dev` load the project-root .env automatically; real environment variables take precedence.
# A container has no .env: its environment comes from the image's ENV defaults plus `docker run -e` / `--env-file`.

# ===== ports =====
PORT=10000
OPENCODE_SERVER_PORT=10001
# If an external opencode serve instance is already running, set this to reuse it (no subprocess is spawned)
# OPENCODE_SERVER_URL=http://127.0.0.1:10001

# ===== OpenCode backend auth (required, protects opencode serve) =====
OPENCODE_SERVER_PASSWORD=your-opencode-server-password

# ===== inbound API KEY auth (optional switch) =====
API_KEY_ENABLED=false
# Accepted keys: API_KEYS_FILE holds one **plaintext** key per line (blank lines and # comments ignored,
# compared as written — no encryption/hashing). API_KEY is merged into that set and comes first.
# With auth on but no key found, every request gets 401.
API_KEY=
# Host path, used by `npm start` / `npm run dev`. Inside a container the image already presets
# API_KEYS_FILE=/app/config/.keys (the image's own config directory; a ./config bind mount replaces it), so
# **do not** forward this host line into Docker: `--env-file` with a Windows path points at a file that does not
# exist there, the key list comes back empty and every request gets 401 with the gateway looking perfectly healthy.
API_KEYS_FILE=./config/.keys

# ===== search backend key (only for paid backends; the free defaults need none) =====
SEARCH_API_KEY=

# ===== custom local provider name (default: ollama-local) =====
# The provider id you declare as the `providers` key in config/opencode.json. The gateway uses it to keep that
# provider out of the `auto` pool and to pick the default web-search model, so it must match exactly.
# Renaming it here is not enough on its own: config/config.yaml `models.allow` (the regex) and `ollama.aliases`
# spell the same name literally, and opencode.json uses it as the key — change all of them together.
# Must not be "ollama": that namespace belongs to OpenCode's own built-in provider.
# OLLAMA_LOCAL_PROVIDER=ollama-local

# ===== provider keys referenced by config/opencode.json via {env:VAR} interpolation =====
# Ollama / OpenAI-compatible provider key declared in the provider settings.
OLLAMA_API_KEY=
# Optional: pin a specific server-side websearch backend (exa / firecrawl / parallel / tavily / tinyfish)
# and supply its key. Not needed for the default "random" provider, which uses backends reachable
# without a user credential.
TAVILY_API_KEY=
# Optional: full OpenCode config override for the spawned serve (JSON). The image ships
# {"websearch":{"provider":"random"}}; setting this replaces that value entirely.
# OPENCODE_CONFIG_CONTENT={"websearch":{"provider":"tavily","apiKey":"{env:TAVILY_API_KEY}"}}

# ===== config file path (default ./config/config.yaml) =====
CONFIG_PATH=./config/config.yaml

# ===== gateway log level (default info) =====
# LOG_LEVEL=info

# Notes:
# - @opencode/cli / @opencode/client versions are pinned at Dockerfile build time, not via environment variables (they must match).
# - Models / auto / ollama aliases / web-search and search defaults all live in config/config.yaml (shipped with the repository).
# - The Ollama provider and the server-side websearch provider are configured in config/opencode.json.
#   The committed template config/opencode.json.example is what the image bakes as /app/config/opencode.json, so a
#   bare `docker run` already has the custom models; the real config/opencode.json is never committed and never
#   baked (it may hold a plaintext key). Mount ./config over /app/config to override — note that replaces the whole
#   directory, so a mounted dir without opencode.json loses the baked default too.
#   That file references keys as {env:OLLAMA_API_KEY} / {env:TAVILY_API_KEY}, so the values only live here.
#   Leaving OLLAMA_API_KEY empty is not an error: interpolation yields "" and the provider still registers and lists
#   its models; set it only when the endpoint actually checks Authorization.
#   Running locally with Ollama: copy the template, then start with OPENCODE_CONFIG=./config/opencode.json npm start
#   so opencode serve reads that file (by default it only auto-discovers the project-root / global opencode.json).
# - Full deployment walkthrough (which variables are mandatory, what the image presets, how to override without
#   rebuilding): docs/docker-deployment.md.
