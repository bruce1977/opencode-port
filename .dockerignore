# Slim build context: these only bloat the image and may shadow the dependencies installed inside it
node_modules
npm-debug.log*
coverage
output
logs
.temp

.git
.gitignore
.github

# Secrets come from runtime environment variables only and must never enter an image layer
.env
.env.*

# Docs and tests stay out of the runtime image (config/config.yaml is packaged with it)
docs
tests
*.md

# Provider config holds local addresses/keys: mounted read-only from ./config at runtime, never baked into an image layer
config/opencode.json
# Accepted API keys live in the same mounted directory; the template config/.keys.example may be packaged, the real file may not
config/.keys
